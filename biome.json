{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "frontend/dist",
      "frontend/src/api/apiSchemas.ts",
      "frontend/src/api/apiComponents.ts",
      "frontend/src/api/apiContext.ts",
      "frontend/src/api/apiFetcher.ts",
      "backend",
      ".venv",
      "__pycache__"
    ]
  }
}

